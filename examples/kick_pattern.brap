// Kick and bass — the smallest thing worth listening to.
fn kick() = {
  let sweep = 50 + 150 * perc(0.001, 0.05)
  let click = noise() * perc(0.001, 0.006)
  sin(sweep) * perc(0.002, 0.4) * 0.9 + click * 0.1
}

fn bass(n) = {
  let hz = n.m2h
  let osc = saw(hz) + saw(hz * 2) * 0.5 + saw(hz * 3) * 0.25
  let amp = env(0.005, 0.32, 0.5, 0.06, dur)
  (osc * amp).lowpass(660, 0.7) * 0.5  .
}

// Slash \ is a trigger and ` is a rest 
play([\, `, \, `], kick)

// A minor: root, root, minor third, root.
play([a2, `, a2, `, e4, `, a2, g2, `], bass, 1.25)


