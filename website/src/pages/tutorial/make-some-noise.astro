---
import TutorialLayout from "../../layouts/TutorialLayout.astro";
import Code from "../../components/Code.astro";
import { pageBySlug } from "../../lib/tutorial";

const page = pageBySlug("make-some-noise")!;

const kbd =
	"rounded border border-neutral-300 bg-neutral-50 px-1.5 py-0.5 font-mono text-xs text-neutral-700 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300";
const code =
	"rounded bg-neutral-100 px-1 py-0.5 font-mono text-[0.9em] text-neutral-800 dark:bg-neutral-800/70 dark:text-neutral-200";
---


<TutorialLayout
	title={page.title}
	description={page.blurb}
	current={page.slug}
>

</TutorialLayout>