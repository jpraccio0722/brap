---
import Layout from "../layouts/Layout.astro";
import IslandCheck from "../components/IslandCheck.tsx";
---

<Layout title="Scree">
	<main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-8 px-6 py-16">
		<div class="space-y-3">
			<h1 class="text-4xl font-semibold tracking-tight">Scree</h1>
			<p class="text-lg text-neutral-600 dark:text-neutral-400">
				A rust-like live coding and synthesis language built on top of{" "}
				<a
					class="text-blue-700 hover:underline dark:text-blue-400"
					href="https://github.com/SamiPerttu/fundsp">fundsp</a
				>.
			</p>
		</div>

		<p>
			<a
				href="/docs/"
				class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-700 hover:underline dark:text-blue-400"
			>
				Function reference
				<span aria-hidden="true">→</span>
			</a>
		</p>
	</main>
</Layout>
