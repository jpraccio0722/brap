---
interface Props {
	text: string;
}

const { text } = Astro.props;

/**
 * The doc strings are written with backticks around code — `from`, `play(pat,
 * lead)` — a convention the editor's panel shows raw because it is already a
 * monospaced column beside monospaced code. A proportional page is not, so the
 * spans are set as code here rather than left as punctuation.
 *
 * Split rather than parsed: this is the one piece of markup the tables use, and
 * a markdown dependency to find it would be a lot of machinery for a backtick.
 * An unpaired backtick keeps its text — `split` simply yields no closing half,
 * and the odd trailing segment falls through as prose.
 */
const parts = text.split(/`([^`]+)`/);
---

{
	parts.map((part, i) =>
		i % 2 === 1 ? (
			<code class="rounded bg-neutral-100 px-1 py-0.5 font-mono text-[0.85em] text-neutral-800 dark:bg-neutral-800/70 dark:text-neutral-200">
				{part}
			</code>
		) : (
			part
		),
	)
}
